# Daemon token for authenticating agent connections
# Required for both WebSocket and MCP sessions
COASTY_TOKEN=changeme

# WebSocket server port (default if not set)
WS_PORT=8765

# HTTP status server port (default if not set)
STATUS_PORT=8766

# MCP stdio logging (set to 1 for debug output)
MCP_LOG=0

# Browser preferences
# Chrome/Edge/Brave will be auto-detected on all platforms
# Set BROWSER_PATH to override auto-detection
BROWSER_PATH=

# Screenshot quality (0-100)
SCREENSHOT_QUALITY=70

# Max screenshot dimension (will be resized to fit max_width x max_height)
SCREENSHOT_MAX_WIDTH=1920
SCREENSHOT_MAX_HEIGHT=1080

# Command timeout in milliseconds
COMMAND_TIMEOUT=60000
